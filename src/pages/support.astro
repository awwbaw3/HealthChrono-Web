---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Support & Help Center | HealthChrono"
  description="Need assistance with HealthChrono? Contact our customer support team at info@drit.ninja or submit a ticket through our help desk."
>
  <div class="bg-slate-900 text-white py-16 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-900/60 text-emerald-400 border border-emerald-500/30 mb-4">
        Customer Support & Help Desk
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-heading">How Can We Help You?</h1>
      <p class="mt-3 text-slate-400 text-base max-w-xl">
        Our dedicated support team is here to assist with any questions about tracking symptoms, medication regimens, subscription billing, or account management.
      </p>
    </div>
  </div>

  <div class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left Column: Support Form -->
        <div class="lg:col-span-7 bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm">
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-slate-900 font-heading">Submit a Support Ticket</h2>
            <p class="text-sm text-slate-600 mt-1">
              Fill out the form below. Notifications are delivered directly to our support engineering desk at <span class="font-semibold text-emerald-700">info@drit.ninja</span>.
            </p>
          </div>

          <!-- Netlify Forms Configuration -->
          <form 
            name="support" 
            method="POST" 
            data-netlify="true" 
            action="/support-success" 
            class="space-y-6"
          >
            <input type="hidden" name="form-name" value="support" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">
                  Your Full Name <span class="text-rose-500">*</span>
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Jane Doe" 
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">
                  Email Address <span class="text-rose-500">*</span>
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="jane@example.com" 
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="platform" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">
                  Operating System / Device
                </label>
                <select 
                  id="platform" 
                  name="platform" 
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all bg-white"
                >
                  <option value="iOS">Apple iOS (iPhone / iPad)</option>
                  <option value="Android">Google Android</option>
                  <option value="Web">Web / Other</option>
                </select>
              </div>

              <div>
                <label for="topic" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">
                  Inquiry Topic <span class="text-rose-500">*</span>
                </label>
                <select 
                  id="topic" 
                  name="topic" 
                  required
                  class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all bg-white"
                >
                  <option value="General Support">General App Question</option>
                  <option value="Medication Timers">Medication Reminders & Schedules</option>
                  <option value="Doctor Reports">Clinical PDF Report Export</option>
                  <option value="Subscriptions">Subscription & Billing (Pro)</option>
                  <option value="Bug Report">Bug or Crash Report</option>
                  <option value="Data Deletion">Account / Data Deletion Request</option>
                </select>
              </div>
            </div>

            <div>
              <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">
                Subject
              </label>
              <input 
                type="text" 
                id="subject" 
                name="subject" 
                placeholder="Brief summary of your question" 
                class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all"
              />
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">
                Message Details <span class="text-rose-500">*</span>
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required 
                placeholder="Please describe what you are experiencing or what question you have..." 
                class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all resize-y"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-xl font-semibold text-white bg-emerald-600 hover:bg-emerald-700 shadow-md hover:shadow-lg transition-all"
            >
              Send Support Request
            </button>
          </form>
        </div>

        <!-- Right Column: Direct Info & Quick Guides -->
        <div class="lg:col-span-5 space-y-8">
          
          <!-- Direct Support Card -->
          <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl font-bold">
              ✉️
            </div>
            <h3 class="text-xl font-bold text-slate-900 font-heading">Direct Email Support</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Prefer to email us directly? Send your questions or screenshots directly to our support desk:
            </p>
            <div class="pt-1">
              <a href="mailto:info@drit.ninja" class="text-base font-bold text-emerald-600 hover:underline break-all">
                info@drit.ninja
              </a>
            </div>
            <div class="pt-2 text-xs text-slate-500 space-y-1">
              <p>⏱️ Average Response Time: Under 24–48 hours</p>
              <p>🌐 Monday – Friday: 9:00 AM – 6:00 PM EST</p>
            </div>
          </div>

          <!-- Common Self-Service Guides -->
          <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm space-y-5">
            <h3 class="text-lg font-bold text-slate-900 font-heading">Quick Troubleshooting Guides</h3>
            
            <div class="space-y-4 text-sm text-slate-600">
              <div class="border-b border-slate-100 pb-3">
                <div class="font-semibold text-slate-900 mb-1">Restoring In-App Subscriptions</div>
                <p class="text-xs">
                  If you reinstalled the app or upgraded your phone, go to <strong>Settings &gt; Upgrade</strong> and tap <em>Restore Purchases</em>.
                </p>
              </div>

              <div class="border-b border-slate-100 pb-3">
                <div class="font-semibold text-slate-900 mb-1">Generating Clinical PDF for Your Doctor</div>
                <p class="text-xs">
                  Open the app &gt; <strong>Settings &gt; Export Data</strong> &gt; choose your date interval &gt; tap <em>Export Clinical PDF</em>.
                </p>
              </div>

              <div class="pb-1">
                <div class="font-semibold text-slate-900 mb-1">Account & Data Deletion</div>
                <p class="text-xs">
                  To permanently erase all local and cloud health records, see our <a href="/delete-data" class="text-emerald-600 font-semibold underline">Data Deletion Guide</a>.
                </p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</Layout>
