---
import Layout from '../layouts/Layout.astro';
---

<Layout title="HealthChrono: Symptom Tracker & Medication Management">
  <!-- HERO SECTION -->
  <section class="relative overflow-hidden bg-gradient-to-b from-white via-slate-50 to-emerald-50/30 pt-16 pb-24 lg:pt-24 lg:pb-32 border-b border-slate-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Health & Symptom Companion for iOS & Android
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15] font-heading">
            Transform Daily Health Logs into <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-600">Physician-Ready</span> Clarity.
          </h1>

          <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
            Effortlessly log daily symptoms, manage complex medication schedules, set custom dose reminders, and generate structured clinical summaries your doctor can review in seconds.
          </p>

          <!-- Store Download Buttons & Action -->
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a href="#download" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-xl bg-slate-900 text-white hover:bg-slate-800 transition-all shadow-md hover:shadow-lg group">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.66-1.08 1.74-.95 2.76 1.01.08 2.06-.51 2.68-1.26z"/>
              </svg>
              <div class="text-left">
                <div class="text-[10px] uppercase tracking-wider text-slate-300 -mb-1">Available on</div>
                <div class="text-sm font-bold tracking-tight">Apple App Store</div>
              </div>
            </a>

            <a href="#download" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-xl bg-slate-900 text-white hover:bg-slate-800 transition-all shadow-md hover:shadow-lg group">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M3.609 1.814L13.792 12 3.61 22.186c-.198-.184-.319-.447-.319-.742V2.556c0-.295.121-.558.318-.742zm11.238 11.24l2.25 2.25-11.455 6.613 9.205-8.863zm0-2.108L5.642 2.083l11.455 6.613-2.25 2.25zm1.488 1.054l3.195 1.844c.645.373.645.981 0 1.354l-3.195 1.844-2.108-2.108 2.108-2.108z"/>
              </svg>
              <div class="text-left">
                <div class="text-[10px] uppercase tracking-wider text-slate-300 -mb-1">Get it on</div>
                <div class="text-sm font-bold tracking-tight">Google Play</div>
              </div>
            </a>
          </div>

          <!-- Feature Bullets -->
          <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-y-2 gap-x-6 text-xs text-slate-500 font-medium">
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              100% Offline Capable
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              Hardware-Backed AES-256
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              Biometric Lock (Face ID / Touch ID)
            </span>
          </div>
        </div>

        <!-- Hero Mockup Display -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end relative">
          <div class="relative w-[280px] sm:w-[320px] rounded-[44px] p-3 bg-slate-900 shadow-2xl ring-1 ring-slate-800/60 transition-transform hover:scale-[1.02] duration-300">
            <!-- Screen container -->
            <div class="relative rounded-[36px] overflow-hidden bg-slate-950 aspect-[9/19.5]">
              <img src="/screenshots/01_dashboard.png" alt="HealthChrono Dashboard" class="w-full h-full object-cover" />
            </div>

            <!-- Floating Adherence Card -->
            <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl p-4 shadow-xl border border-slate-100 flex items-center gap-3.5 max-w-[240px]">
              <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg">
                ✓
              </div>
              <div>
                <div class="text-xs text-slate-500 font-medium">Medication Adherence</div>
                <div class="text-sm font-bold text-slate-900">100% on schedule</div>
              </div>
            </div>

            <!-- Floating Doctor Report Badge -->
            <div class="absolute -top-4 -right-4 bg-white rounded-2xl p-3.5 shadow-xl border border-slate-100 hidden sm:flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center">
                📄
              </div>
              <div class="text-left">
                <div class="text-[10px] text-slate-500 font-medium">Clinical Report</div>
                <div class="text-xs font-bold text-slate-900">PDF Ready</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST & VALUE METRICS BANNER -->
  <section class="bg-slate-900 text-white py-12 border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-slate-800">
        <div class="px-4">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-heading">AES-256</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1 font-medium">Local Hardware Encryption</div>
        </div>
        <div class="px-4 pt-6 md:pt-0">
          <div class="text-2xl sm:text-3xl font-extrabold text-teal-400 font-heading">1-Tap</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1 font-medium">Physician PDF Export</div>
        </div>
        <div class="px-4 pt-6 md:pt-0">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-heading">100% Offline</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1 font-medium">Zero Cloud Dependency</div>
        </div>
        <div class="px-4 pt-6 md:pt-0">
          <div class="text-2xl sm:text-3xl font-extrabold text-teal-400 font-heading">0 Trackers</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1 font-medium">No Ads & No Data Sales</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES SECTION -->
  <section id="features" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-20 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-emerald-600">Engineered for Health Management</h2>
        <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 font-heading">
          Everything You Need to Track, Manage, and Communicate Your Health.
        </p>
        <p class="text-base text-slate-600 leading-relaxed">
          Whether you're navigating a chronic condition, recovering from surgery, or managing daily prescriptions, HealthChrono replaces messy notes with structured clinical data.
        </p>
      </div>

      <!-- Feature 1: Symptom Tracking -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-24">
        <div class="lg:col-span-6 space-y-6 order-2 lg:order-1">
          <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xl">
            🩺
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 font-heading">
            Rapid Symptom Logging with Clinical Severity Scales
          </h3>
          <p class="text-slate-600 leading-relaxed">
            Record pain levels, fatigue, flare-ups, or custom symptoms in seconds. Rate intensity on a standardized 1–10 clinical scale, tag custom triggers, and record time-stamped contextual notes before you forget.
          </p>
          <ul class="space-y-3 text-sm text-slate-700 font-medium">
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs">✓</span>
              Standardized 1-10 severity metrics
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs">✓</span>
              Custom symptom tags (Headache, Joint Pain, Nausea, Insomnia)
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs">✓</span>
              Detailed contextual notes & chronological timeline
            </li>
          </ul>
        </div>
        <div class="lg:col-span-6 flex justify-center order-1 lg:order-2">
          <div class="w-[280px] sm:w-[310px] rounded-[40px] p-2.5 bg-slate-900 shadow-xl">
            <img src="/screenshots/02_symptoms.png" alt="Symptom Tracking Interface" class="rounded-[32px] w-full" />
          </div>
        </div>
      </div>

      <!-- Feature 2: Medication Management -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-24">
        <div class="lg:col-span-6 flex justify-center order-1">
          <div class="w-[280px] sm:w-[310px] rounded-[40px] p-2.5 bg-slate-900 shadow-xl">
            <img src="/screenshots/03_medications.png" alt="Medication Management & Reminders" class="rounded-[32px] w-full" />
          </div>
        </div>
        <div class="lg:col-span-6 space-y-6 order-2">
          <div class="w-12 h-12 rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-xl">
            💊
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 font-heading">
            Prescription Schedules & Smart Dose Timers
          </h3>
          <p class="text-slate-600 leading-relaxed">
            Never miss an essential dose again. Set customized multi-dose reminders, input exact dosages (mg, ml, puffs), and mark doses as taken with a single tap. HealthChrono tracks adherence automatically.
          </p>
          <ul class="space-y-3 text-sm text-slate-700 font-medium">
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs">✓</span>
              Complex recurring schedules (daily, twice daily, PRN as needed)
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs">✓</span>
              Reliable local device alarms & smart reminders
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs">✓</span>
              Clear adherence logs for doctor consultations
            </li>
          </ul>
        </div>
      </div>

      <!-- Feature 3: Clinical PDF Reports -->
      <div id="clinical-reports" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6 order-2 lg:order-1">
          <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xl">
            📊
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 font-heading">
            Physician-Ready Clinical Summaries in Seconds
          </h3>
          <p class="text-slate-600 leading-relaxed">
            Doctors rarely have time to sift through unstructured notes. HealthChrono synthesizes your logs into a clean, professional, high-density PDF summary report formatted specifically for clinical review.
          </p>
          <ul class="space-y-3 text-sm text-slate-700 font-medium">
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs">✓</span>
              Printable PDF, CSV, and structured JSON export formats
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs">✓</span>
              Filter by date range (last 7 days, 30 days, or custom interval)
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs">✓</span>
              Clear medication adherence percentages & symptom frequency
            </li>
          </ul>
        </div>
        <div class="lg:col-span-6 flex justify-center order-1 lg:order-2">
          <div class="w-[280px] sm:w-[310px] rounded-[40px] p-2.5 bg-slate-900 shadow-xl">
            <img src="/screenshots/04_clinical_report.png" alt="Clinical PDF Report Preview" class="rounded-[32px] w-full" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECURITY & PRIVACY SECTION -->
  <section id="security" class="py-24 bg-slate-900 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-emerald-400">Zero-Compromise Security</h2>
        <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-heading">
          Your Personal Health Data Belongs to You. Period.
        </p>
        <p class="text-base text-slate-400 leading-relaxed">
          Health data is the most sensitive information you own. That's why HealthChrono is architected from the ground up with local encryption, biometric defense, and zero ad-tracking.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-8 space-y-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-900/60 border border-emerald-500/30 text-emerald-400 flex items-center justify-center text-xl">
            🔒
          </div>
          <h3 class="text-xl font-bold text-white font-heading">AES-256 Local Encryption</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Your records are stored securely on your physical device using hardware-backed cryptographic keystores (iOS Keychain & Android KeyStore).
          </p>
        </div>

        <!-- Card 2 -->
        <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-8 space-y-4">
          <div class="w-12 h-12 rounded-xl bg-teal-900/60 border border-teal-500/30 text-teal-400 flex items-center justify-center text-xl">
            🛡️
          </div>
          <h3 class="text-xl font-bold text-white font-heading">Biometric Gatekeeper</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Add an instant biometric shield. Unlock your logs using Face ID, Touch ID, or your device passcode so unauthorized hands never view your entries.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-8 space-y-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-900/60 border border-emerald-500/30 text-emerald-400 flex items-center justify-center text-xl">
            🚫
          </div>
          <h3 class="text-xl font-bold text-white font-heading">Zero Advertising & No Data Sales</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            We do not sell data to advertisers, insurance brokers, or data aggregators. HealthChrono complies with GDPR, CCPA/CPRA, and FTC Health Breach standards.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/privacy" class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400 hover:text-emerald-300 transition-colors">
          Read our complete Privacy Policy &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- SCREENSHOT SHOWCASE GALLERY -->
  <section class="py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-emerald-600">Interface Gallery</h2>
        <p class="text-3xl font-extrabold text-slate-900 font-heading">Crafted for Simplicity and Precision</p>
        <p class="text-sm text-slate-600">Explore authentic screen captures from the HealthChrono mobile experience.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
        <div class="space-y-3 text-center">
          <div class="rounded-3xl p-2 bg-slate-900 shadow-md">
            <img src="/screenshots/01_dashboard.png" alt="Daily Overview Dashboard" class="rounded-2xl w-full" />
          </div>
          <p class="text-xs font-bold text-slate-700">1. Overview Dashboard</p>
        </div>
        <div class="space-y-3 text-center">
          <div class="rounded-3xl p-2 bg-slate-900 shadow-md">
            <img src="/screenshots/02_symptoms.png" alt="Symptom Diary" class="rounded-2xl w-full" />
          </div>
          <p class="text-xs font-bold text-slate-700">2. Symptom Logger</p>
        </div>
        <div class="space-y-3 text-center">
          <div class="rounded-3xl p-2 bg-slate-900 shadow-md">
            <img src="/screenshots/03_medications.png" alt="Medication Schedules" class="rounded-2xl w-full" />
          </div>
          <p class="text-xs font-bold text-slate-700">3. Medication Timers</p>
        </div>
        <div class="space-y-3 text-center">
          <div class="rounded-3xl p-2 bg-slate-900 shadow-md">
            <img src="/screenshots/04_clinical_report.png" alt="Clinical PDF Generator" class="rounded-2xl w-full" />
          </div>
          <p class="text-xs font-bold text-slate-700">4. Physician Report</p>
        </div>
        <div class="space-y-3 text-center">
          <div class="rounded-3xl p-2 bg-slate-900 shadow-md">
            <img src="/screenshots/05_premium_upgrade.png" alt="HealthChrono Pro Tier" class="rounded-2xl w-full" />
          </div>
          <p class="text-xs font-bold text-slate-700">5. Pro Upgrade</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section id="faq" class="py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-emerald-600">Got Questions?</h2>
        <p class="text-3xl font-extrabold text-slate-900 font-heading">Frequently Asked Questions</p>
      </div>

      <div class="space-y-6">
        <details class="group bg-slate-50 border border-slate-200 rounded-2xl p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-base">
            <span>Does HealthChrono work without an internet connection?</span>
            <span class="ml-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-4 text-sm text-slate-600 leading-relaxed">
            Yes, 100%. HealthChrono is built with an offline-first architecture. All your symptoms, notes, and medication schedules are saved directly to your device's local database. When internet connectivity is restored, data synchronizes quietly in the background if cloud sync is enabled.
          </p>
        </details>

        <details class="group bg-slate-50 border border-slate-200 rounded-2xl p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-base">
            <span>How do I share my reports with my doctor?</span>
            <span class="ml-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-4 text-sm text-slate-600 leading-relaxed">
            Navigate to <strong>Settings &gt; Export Data</strong> inside the application. Select your preferred date range (e.g. past 30 days) and tap <em>Generate Clinical PDF</em>. You can print the document, email it securely to your clinic, or upload it to your healthcare patient portal.
          </p>
        </details>

        <details class="group bg-slate-50 border border-slate-200 rounded-2xl p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-base">
            <span>Is my health data private and encrypted?</span>
            <span class="ml-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-4 text-sm text-slate-600 leading-relaxed">
            Yes. All local data is encrypted at rest using AES-256 with platform-managed hardware keystores. When synchronized over the network, communication is enforced via TLS 1.3 encryption. We never sell your personal information or monetize health records with ad networks.
          </p>
        </details>

        <details class="group bg-slate-50 border border-slate-200 rounded-2xl p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-base">
            <span>How do I delete my account or stored data?</span>
            <span class="ml-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-4 text-sm text-slate-600 leading-relaxed">
