---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title,
  description = "HealthChrono is your intelligent personal health companion. Effortlessly log symptoms, track medication regimens, set dose timers, and generate physician-ready clinical summaries.",
  ogImage = "/feature-graphic.png",
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const siteUrl = "https://gethealthchrono.com";
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const socialImage = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#065f46" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="HealthChrono" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Inter Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 flex flex-col antialiased selection:bg-emerald-500 selection:text-white">
    <!-- Top Announcement / Compliance Bar -->
    <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 text-center border-b border-slate-800">
      <span class="inline-flex items-center gap-1.5 font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Zero-Knowledge Local Storage &bull; End-to-End Encrypted Cloud Sync &bull; Biometric Device Lock
      </span>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          <!-- Logo & Brand -->
          <a href="/" class="flex items-center gap-3 group">
            <img src="/icon.png" alt="HealthChrono Logo" class="w-10 h-10 rounded-xl shadow-sm group-hover:scale-105 transition-transform" />
            <div class="flex flex-col">
              <span class="text-xl font-bold tracking-tight text-slate-900 font-heading">HealthChrono</span>
              <span class="text-[10px] tracking-wider uppercase font-semibold text-emerald-600 -mt-1">Symptom Tracker</span>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
            <a href="/#features" class="hover:text-emerald-600 transition-colors">Features</a>
            <a href="/#clinical-reports" class="hover:text-emerald-600 transition-colors">Clinical Reports</a>
            <a href="/#security" class="hover:text-emerald-600 transition-colors">Privacy & Security</a>
            <a href="/#faq" class="hover:text-emerald-600 transition-colors">FAQ</a>
            <a href="/support" class="hover:text-emerald-600 transition-colors">Support</a>
          </nav>

          <!-- Header Action Button -->
          <div class="hidden md:flex items-center gap-4">
            <a href="/#download" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm hover:shadow transition-all">
              Download App
            </a>
          </div>

          <!-- Mobile Menu Button -->
          <div class="flex md:hidden">
            <button id="mobile-menu-btn" type="button" class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none" aria-label="Toggle navigation">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Menu Panel -->
        <div id="mobile-menu" class="hidden md:hidden pb-6 pt-2 border-t border-slate-100">
          <div class="flex flex-col gap-3 font-medium text-slate-600">
            <a href="/#features" class="px-2 py-2 rounded-md hover:bg-slate-100 hover:text-emerald-600">Features</a>
            <a href="/#clinical-reports" class="px-2 py-2 rounded-md hover:bg-slate-100 hover:text-emerald-600">Clinical Reports</a>
            <a href="/#security" class="px-2 py-2 rounded-md hover:bg-slate-100 hover:text-emerald-600">Privacy & Security</a>
            <a href="/#faq" class="px-2 py-2 rounded-md hover:bg-slate-100 hover:text-emerald-600">FAQ</a>
            <a href="/support" class="px-2 py-2 rounded-md hover:bg-slate-100 hover:text-emerald-600">Support</a>
            <a href="/privacy" class="px-2 py-2 rounded-md hover:bg-slate-100 hover:text-emerald-600">Privacy Policy</a>
            <a href="/terms" class="px-2 py-2 rounded-md hover:bg-slate-100 hover:text-emerald-600">Terms of Service</a>
            <a href="/delete-data" class="px-2 py-2 rounded-md hover:bg-slate-100 hover:text-emerald-600">Delete Account & Data</a>
            <div class="pt-3">
              <a href="/#download" class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-full text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700">
                Download App
              </a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Body Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-slate-900 text-slate-400 pt-16 pb-12 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
          <!-- Brand Info -->
          <div class="md:col-span-2 space-y-4">
            <div class="flex items-center gap-3">
              <img src="/icon.png" alt="HealthChrono" class="w-10 h-10 rounded-xl" />
              <span class="text-xl font-bold tracking-tight text-white font-heading">HealthChrono</span>
            </div>
            <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
              Your intelligent personal health companion designed to effortlessly log symptoms, organize medication schedules, set custom dose reminders, and generate physician-ready clinical summaries.
            </p>
            <div class="pt-2 text-xs text-slate-500">
              Direct Support: <a href="mailto:info@drit.ninja" class="text-emerald-400 hover:underline">info@drit.ninja</a>
            </div>
          </div>

          <!-- Product Links -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-4">Product</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/#features" class="hover:text-white transition-colors">Symptom Tracking</a></li>
              <li><a href="/#features" class="hover:text-white transition-colors">Medication Management</a></li>
              <li><a href="/#clinical-reports" class="hover:text-white transition-colors">Clinical PDF Reports</a></li>
              <li><a href="/#security" class="hover:text-white transition-colors">AES-256 Encryption</a></li>
              <li><a href="/#download" class="hover:text-white transition-colors">App Store & Google Play</a></li>
            </ul>
          </div>

          <!-- Legal & Trust -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-4">Legal & Privacy</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
              <li><a href="/delete-data" class="hover:text-white transition-colors">Account & Data Deletion</a></li>
              <li><a href="/#security" class="hover:text-white transition-colors">GDPR & CCPA Compliance</a></li>
            </ul>
          </div>

          <!-- Support & Help -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-4">Support</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/support" class="hover:text-white transition-colors">Help Center & Contact</a></li>
              <li><a href="/#faq" class="hover:text-white transition-colors">Frequently Asked Questions</a></li>
              <li><a href="mailto:info@drit.ninja" class="hover:text-white transition-colors">info@drit.ninja</a></li>
            </ul>
          </div>
        </div>

        <!-- Medical Disclaimer -->
        <div class="py-8 border-b border-slate-800 text-xs leading-relaxed text-slate-500">
          <p class="font-medium text-slate-400 mb-1">IMPORTANT MEDICAL DISCLAIMER:</p>
          <p>
            HealthChrono is an independent digital health journal, medication organizer, and informational companion. HealthChrono is <strong>not</strong> a medical device, diagnostic system, or telehealth service, and does not provide medical diagnosis, clinical treatment advice, or emergency triage. The content, charts, logs, and clinical summaries generated by the application are intended solely to assist users in documenting self-reported observations for discussion with licensed physicians. If you are experiencing a medical emergency, call 911 (or your local emergency telephone number) or visit the nearest emergency department immediately.
          </p>
        </div>

        <!-- Copyright & Subtext -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>&copy; {new Date().getFullYear()} HealthChrono Inc. All rights reserved.</p>
          <div class="flex items-center gap-6">
            <a href="/privacy" class="hover:underline">Privacy</a>
            <a href="/terms" class="hover:underline">Terms</a>
            <a href="/support" class="hover:underline">Support</a>
            <a href="/delete-data" class="hover:underline">Data Safety</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
